# Secrets and settings this project needs: names only, never values.
#
# This file is documentation. Nothing loads it, and there is no real .env:
# values live in Doppler (or GitHub), and commands read them by name, e.g.
#   doppler run --only-secrets GRAFANA_ADMIN_PASSWORD -- <command>
# so a value never appears in a file, in argv or in the terminal.
#
# Each entry: where it is stored, what uses it, and the Linear issue.

# ---------------------------------------------------------------------------
# Doppler: used by the owner's runbook commands to create Kubernetes Secrets
# ---------------------------------------------------------------------------

# Slack app bot token (xoxb-..., scope chat:write, invited to #alerts).
# -> Secret argocd-notifications-secret, key slack-token (namespace argocd).
# Runbook: docs/runbooks/deploy.md step 4. DEV-141.
SLACK_ARGOCD_BOT_TOKEN=

# Argo CD admin password, set after the first login rotation.
# Only kept so you can log in again; nothing reads it automatically. DEV-141.
ARGOCD_ADMIN_PASSWORD=

# Grafana admin login.
# -> Secret grafana-admin, keys admin-user / admin-password (namespace monitoring).
# DEV-142.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Docker Hub pull credentials for the cluster, needed only if the app images
# are private. Use a read-only access token.
# -> Secret dockerhub-pull (docker-registry type) in each app namespace,
#    referenced by the charts' imagePullSecrets. Namespace decided in DEV-125.
DOCKERHUB_PULL_USERNAME=
DOCKERHUB_PULL_TOKEN=

# ---------------------------------------------------------------------------
# GitHub Actions repository secrets (Settings > Secrets and variables > Actions)
# ---------------------------------------------------------------------------

# aws-platform: Snyk IaC scan. The job is skipped until this exists. DEV-163.
SNYK_TOKEN=

# sre-inference-gateway and promscope: image push to Docker Hub.
# Access token with Read & Write on that one repository only. DEV-137, DEV-138.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# ---------------------------------------------------------------------------
# GitHub Actions repository variables (not secret)
# ---------------------------------------------------------------------------

# aws-platform: ARN of the plan-only role, from `terraform output` in account/
# after DEV-133 is applied. Used by the plan workflow. DEV-135.
AWS_CI_PLAN_ROLE_ARN=

# ---------------------------------------------------------------------------
# Later (not needed for P1)
# ---------------------------------------------------------------------------

# Tailscale auth key for the VPC subnet router: reusable, ephemeral, tagged.
# Only if the Pi hub / private endpoint work (DEV-155) is picked up.
TAILSCALE_AUTHKEY=

# ---------------------------------------------------------------------------
# Not secrets, so not listed: AWS access (Identity Center SSO, no keys), the
# kubeconfig (generated by `aws eks update-kubeconfig`), and your public IP
# (envs/dev/terraform.tfvars, git-ignored).
# ---------------------------------------------------------------------------
